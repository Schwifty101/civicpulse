# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=civicpulse
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=cache
REDIS_PORT=6379

# --- Backend ---
# rules | simulated | llm | ollama
TRIAGE_PROVIDER=rules
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=15
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Groq (OpenAI-compatible). Only read when TRIAGE_PROVIDER=llm. Sign up at console.groq.com.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (only read when TRIAGE_PROVIDER=ollama; service only starts with --profile ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# --- Frontend runtime config ---
# Leave empty — nginx proxies /api same-origin (see docs/adr/0002-frontend-runtime-config.md).
# Unused by the shipped nginx-proxy approach; kept only as an escape hatch for a
# non-proxied deploy topology this repo doesn't use.
VITE_API_BASE_URL=

# --- Image tags (compose.prod.yaml only — never used by cd.yml, which always passes a
# real commit SHA) ---
# NEVER run `docker compose -f compose.prod.yaml up` with this default unedited — that
# would deploy :latest, which docs/adr/0003-deploy-by-sha.md and §5.3 both rule out.
# Always override at invocation: IMAGE_TAG=<sha> docker compose -f compose.prod.yaml up -d
IMAGE_TAG=latest
REGISTRY=ghcr.io/schwifty101/civicpulse
